{
  "name": "netflix-data-engineering",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },

  "forwardPorts": [9000, 9001],
  "portsAttributes": {
    "9000": {
      "label": "MinIO API (S3-compatible)"
    },
    "9001": {
      "label": "MinIO Console (Web UI)"
    }
  },

  "postCreateCommand": "pip install --user boto3 pandas snowflake-connector-python",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
